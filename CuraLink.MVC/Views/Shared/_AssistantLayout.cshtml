@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool Active(string name) => controller == "Assistant" && action == name;
    var pageTitle = ViewData["PageTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CuraLink</title>

    @* Same includes as your other layouts: adjust the paths if yours differ. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/patient-dashboard.css" asp-append-version="true" />
</head>
<body class="patient-body">
    @Html.AntiForgeryToken()
    <div class="patient-wrapper">

        <!-- Sidebar -->
        <aside class="patient-sidebar" id="assistantSidebar">
            <div class="patient-sidebar-brand">
                <span class="patient-brand-mark"><i class="bi bi-heart-pulse"></i></span>
                <span>CuraLink</span>
            </div>

            <nav class="patient-nav">
                <a class="patient-nav-link @(Active("Index") ? "active" : "")" asp-controller="Assistant" asp-action="Index">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
                <a class="patient-nav-link @(Active("Patients") ? "active" : "")" asp-controller="Assistant" asp-action="Patients">
                    <i class="bi bi-search"></i> Find Patient
                </a>
                <a class="patient-nav-link @(Active("CreatePatient") ? "active" : "")" asp-controller="Assistant" asp-action="CreatePatient">
                    <i class="bi bi-person-plus"></i> Add Patient
                </a>
                <a class="patient-nav-link @(Active("BookAppointment") ? "active" : "")" asp-controller="Assistant" asp-action="BookAppointment">
                    <i class="bi bi-calendar-plus"></i> Book Appointment
                </a>
                <a class="patient-nav-link @(Active("TodayAppointments") ? "active" : "")" asp-controller="Assistant" asp-action="TodayAppointments">
                    <i class="bi bi-calendar-check"></i> Today's Appointments
                </a>

                @if (User.IsInRole("Patient"))
                {
                    <a class="patient-nav-link" asp-controller="Patient" asp-action="Index">
                        <i class="bi bi-person"></i> Patient Dashboard
                    </a>
                }
            </nav>

            <div class="patient-sidebar-footer">
                @* Adjust to your real logout action (Auth/Logout). *@
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="patient-nav-link patient-logout w-100 border-0 bg-transparent text-start">
                        <i class="bi bi-box-arrow-right"></i> Log out
                    </button>
                </form>
            </div>
        </aside>
        <div class="patient-sidebar-backdrop" id="assistantBackdrop"></div>

        <!-- Main -->
        <div class="patient-main">
            <header class="patient-topbar">
                <button type="button" class="patient-sidebar-toggle d-lg-none" id="assistantToggle" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="patient-topbar-title">@pageTitle</h1>
                <span class="ms-auto text-muted small d-none d-sm-inline">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
            </header>

            <main class="patient-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (function() {
                var sidebar = document.getElementById('assistantSidebar');
                var backdrop = document.getElementById('assistantBackdrop');
                var toggle = document.getElementById('assistantToggle');
                function setOpen(open) {
                    sidebar.classList.toggle('open', open);
                    backdrop.classList.toggle('open', open);
                }
                toggle.addEventListener('click', function() { setOpen(!sidebar.classList.contains('open')); });
                backdrop.addEventListener('click', function() { setOpen(false); });
            })();

            window.assistantUrls = @Json.Serialize(new
                {
                            dashboardData = Url.Action("DashboardData", "Assistant"),
                            todayData = Url.Action("TodayData", "Assistant"),
                            searchPatients = Url.Action("SearchPatients", "Assistant"),
                            createPatientApi = Url.Action("CreatePatientApi", "Assistant"),
                            bookApi = Url.Action("BookApi", "Assistant"),
                            checkIn = Url.Action("CheckIn", "Assistant"),
                            bookPage = Url.Action("BookAppointment", "Assistant"),
                            todayPage = Url.Action("TodayAppointments", "Assistant"),
                            loginPage = Url.Action("Login", "Auth")
                });
    </script>
    <script src="~/js/clinic-assistant/common.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
