@{
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsDoctorAction(string action) =>
        currentController.Equals("Doctor", StringComparison.OrdinalIgnoreCase)
        && currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);

    bool isDashboardActive = IsDoctorAction("Dashboard");

    bool isClinicsActive =
        currentController.Equals("Clinic", StringComparison.OrdinalIgnoreCase);

    bool isAppointmentsActive = IsDoctorAction("Appointments");
    bool isPatientsActive = IsDoctorAction("Patients");
    bool isScheduleActive = IsDoctorAction("Schedule");
    bool isProfileActive = IsDoctorAction("Profile") || IsDoctorAction("EditProfile");
    bool isAssistantsActive = IsDoctorAction("Assistants") || IsDoctorAction("AddAssistant");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] — CuraLink</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/doctor-dashboard.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="doctor-body">

    <div class="doctor-wrapper">

        <!-- Sidebar -->
        <aside class="doctor-sidebar" id="doctorSidebar">

            <div class="doctor-sidebar-brand">
                <span class="doctor-brand-mark">
                    <i class="bi bi-heart-pulse-fill"></i>
                </span>

                <span>CuraLink</span>
            </div>

            <nav class="doctor-nav">

                <!-- Dashboard -->
                <a class="doctor-nav-link @(isDashboardActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Dashboard">

                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <!-- My Clinics -->
                <a class="doctor-nav-link @(isClinicsActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-fragment="my-clinics">

                    <i class="bi bi-hospital"></i>
                    My Clinics
                </a>

                <!-- Appointments -->
                <a class="doctor-nav-link @(isAppointmentsActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Appointments">

                    <i class="bi bi-calendar-check"></i>
                    Appointments
                </a>

                <!-- Patients -->
                <a class="doctor-nav-link @(isPatientsActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Patients">

                    <i class="bi bi-people"></i>
                    Patients
                </a>

                <!-- Schedule -->
                <a class="doctor-nav-link @(isScheduleActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Schedule">

                    <i class="bi bi-calendar-week"></i>
                    Schedule
                </a>
                <a class="doctor-nav-link @(isScheduleActive ? "active" : "")"
                   asp-controller="Prescription"
                   asp-action="Index">

                    <i class="bi bi-calendar-week"></i>
                    Prescriptions
                </a>
                <a class="doctor-nav-link @(isAssistantsActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Assistants">

                    <i class="bi bi-person-badge"></i>
                    Assistants
                </a>
                <!-- Profile -->
                <a class="doctor-nav-link @(isProfileActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Profile">

                    <i class="bi bi-person-circle"></i>
                    Profile
                </a>

            </nav>

            <div class="doctor-sidebar-footer">

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </button>

                </form>

            </div>

        </aside>

        <!-- Main -->
        <div class="doctor-main">
            <header class="doctor-topbar">

                <button type="button"
                        class="doctor-sidebar-toggle d-lg-none"
                        id="sidebarToggle"
                        aria-label="Toggle menu">

                    <i class="bi bi-list"></i>

                </button>

                <h1 class="doctor-topbar-title">
                    @ViewData["Title"]
                </h1>

                <!-- Notifications -->
                <div class="doctor-notification-wrapper">

                    <button type="button"
                            class="doctor-notification-btn"
                            id="notificationButton"
                            aria-label="Notifications"
                            title="Notifications">

                        <i class="bi bi-bell"></i>

                        <span class="doctor-notification-badge"
                              id="notificationBadge"
                              style="display: none;">
                            0
                        </span>

                    </button>

                    <!-- Notification dropdown -->
                    <div class="doctor-notification-dropdown"
                         id="notificationDropdown">

                        <div class="doctor-notification-header">

                            <strong>Notifications</strong>

                            <button type="button"
                                    class="doctor-mark-all-read"
                                    id="markAllNotificationsRead">
                                Mark all as read
                            </button>

                        </div>

                        <div class="doctor-notification-list"
                             id="notificationList">

                            <div class="doctor-no-notifications"
                                 id="noNotifications">

                                <i class="bi bi-bell-slash"></i>

                                <span>No new notifications</span>

                            </div>

                        </div>

                    </div>

                </div>

            </header>

            <main class="doctor-content">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle me-2"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>

                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>

                    </div>
                }

                @RenderBody()

            </main>

        </div>
    </div>

    <div class="doctor-sidebar-backdrop d-lg-none"
         id="sidebarBackdrop">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/doctor/layout.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/lib/signalr/signalr.js"></script>
    <script src="~/js/realtime.js" asp-append-version="true"></script>

</body>
</html>
