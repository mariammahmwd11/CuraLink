@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // "My Clinics" currently points at the Dashboard's #my-clinics section
    // since there is no separate Clinic/Index action yet. Once one exists,
    // just repoint the href below — the active-state check already covers
    // both controllers so nothing else needs to change.
    bool isDashboardActive = currentController.Equals("Doctor", StringComparison.OrdinalIgnoreCase);
    bool isClinicsActive = currentController.Equals("Clinic", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CuraLink</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/doctor-dashboard.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="doctor-body">

    <div class="doctor-wrapper">

        <!-- Sidebar -->
        <aside class="doctor-sidebar" id="doctorSidebar">
            <div class="doctor-sidebar-brand">
                <span class="doctor-brand-mark">
                    <i class="bi bi-heart-pulse-fill"></i>
                </span>
                <span>CuraLink</span>
            </div>

            <nav class="doctor-nav">
                <a class="doctor-nav-link @(isDashboardActive ? "active" : "")"
                   asp-controller="Doctor" asp-action="Dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="doctor-nav-link @(isClinicsActive || isDashboardActive ? "active" : "")"
                   asp-controller="Doctor" asp-action="Dashboard" asp-fragment="my-clinics">
                    <i class="bi bi-hospital"></i> My Clinics
                </a>

                <!-- Not implemented yet — no backing controller/API. Left visible
                     per the target IA but inert, so nothing 404s. Remove
                     "disabled" and wire asp-controller/asp-action once each
                     feature has a real endpoint. -->
                <a class="doctor-nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i class="bi bi-calendar-check"></i> Appointments
                    <span class="doctor-nav-soon">Soon</span>
                </a>
                <a class="doctor-nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i class="bi bi-people"></i> Patients
                    <span class="doctor-nav-soon">Soon</span>
                </a>
                <a class="doctor-nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i class="bi bi-calendar-week"></i> Schedule
                    <span class="doctor-nav-soon">Soon</span>
                </a>
                <a class="doctor-nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i class="bi bi-person-circle"></i> Profile
                    <span class="doctor-nav-soon">Soon</span>
                </a>
                <a class="doctor-nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i class="bi bi-gear"></i> Settings
                    <span class="doctor-nav-soon">Soon</span>
                </a>
            </nav>

            <div class="doctor-sidebar-footer">
                <a asp-controller="Auth" asp-action="Logout" class="doctor-nav-link doctor-logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Main -->
        <div class="doctor-main">

            <header class="doctor-topbar">
                <button type="button" class="doctor-sidebar-toggle d-lg-none" id="sidebarToggle" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="doctor-topbar-title">@ViewData["Title"]</h1>
            </header>

            <main class="doctor-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <div class="doctor-sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/doctor/layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
