
@{
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isDashboardActive =
        currentController.Equals("Doctor", StringComparison.OrdinalIgnoreCase)
        && currentAction.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);

    bool isClinicsActive =
        currentController.Equals("Clinic", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] — CuraLink</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/doctor-dashboard.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="doctor-body">

    <div class="doctor-wrapper">

        <!-- Sidebar -->
        <aside class="doctor-sidebar" id="doctorSidebar">

            <div class="doctor-sidebar-brand">
                <span class="doctor-brand-mark">
                    <i class="bi bi-heart-pulse-fill"></i>
                </span>

                <span>CuraLink</span>
            </div>

            <nav class="doctor-nav">

                <!-- Dashboard -->
                <a class="doctor-nav-link @(isDashboardActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Dashboard">

                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <!-- My Clinics -->
                <a class="doctor-nav-link @(isClinicsActive ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-fragment="my-clinics">

                    <i class="bi bi-hospital"></i>
                    My Clinics
                </a>

                <!-- Appointments -->
                <a class="doctor-nav-link disabled"
                   href="#"
                   tabindex="-1"
                   aria-disabled="true">

                    <i class="bi bi-calendar-check"></i>
                    Appointments

                    <span class="doctor-nav-soon">
                        Soon
                    </span>
                </a>

                <!-- Patients -->
                <a class="doctor-nav-link disabled"
                   href="#"
                   tabindex="-1"
                   aria-disabled="true">

                    <i class="bi bi-people"></i>
                    Patients

                    <span class="doctor-nav-soon">
                        Soon
                    </span>
                </a>

                <!-- Schedule -->
                <a class="doctor-nav-link @(currentController.Equals("Doctor", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Schedule", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Doctor"
                   asp-action="Schedule">

                    <i class="bi bi-calendar-week"></i>
                    Schedule
                </a>

                <!-- Profile -->
                <a class="doctor-nav-link disabled"
                   href="#"
                   tabindex="-1"
                   aria-disabled="true">

                    <i class="bi bi-person-circle"></i>
                    Profile

                    <span class="doctor-nav-soon">
                        Soon
                    </span>
                </a>

                <!-- Settings -->
                <a class="doctor-nav-link disabled"
                   href="#"
                   tabindex="-1"
                   aria-disabled="true">

                    <i class="bi bi-gear"></i>
                    Settings

                    <span class="doctor-nav-soon">
                        Soon
                    </span>
                </a>

            </nav>

            <div class="doctor-sidebar-footer">

                <a asp-controller="Auth"
                   asp-action="Logout"
                   class="doctor-nav-link doctor-logout">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </a>

            </div>

        </aside>

        <!-- Main -->
        <div class="doctor-main">

            <header class="doctor-topbar">

                <button type="button"
                        class="doctor-sidebar-toggle d-lg-none"
                        id="sidebarToggle"
                        aria-label="Toggle menu">

                    <i class="bi bi-list"></i>

                </button>

                <h1 class="doctor-topbar-title">
                    @ViewData["Title"]
                </h1>

            </header>

            <main class="doctor-content">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle me-2"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>

                    </div>
                }

                @RenderBody()

            </main>

        </div>
    </div>

    <div class="doctor-sidebar-backdrop d-lg-none"
         id="sidebarBackdrop">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/doctor/layout.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
