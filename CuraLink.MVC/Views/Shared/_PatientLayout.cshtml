@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isActive(string action) =>
        currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CuraLink</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/patient-dashboard.css" asp-append-version="true" />

    @* Notification bell + dropdown — scoped styles kept local to this
       layout so nothing needs to be added to patient-dashboard.css. *@
    <style>
            .patient-notification-bell {
                position: relative;
                border: none;
                background: transparent;
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
                color: var(--cl-text, #14213d);
                transition: background-color .15s ease;
            }

            .patient-topbar > .position-relative {
                margin-left: auto;
            }

            .patient-notification-badge {
                position: absolute;
                top: 3px;
                right: 3px;
                min-width: 18px;
                height: 18px;
                padding: 0 4px;
                border-radius: 999px;
                background: var(--cl-danger, #c0392b);
                color: #fff;
                font-size: .68rem;
                font-weight: 700;
                line-height: 18px;
                text-align: center;
            }

                .patient-notification-badge.d-none {
                    display: none !important;
                }

            .patient-notification-panel {
                position: absolute;
                top: calc(100% + 8px);
                right: 0;
                width: 340px;
                max-width: 90vw;
                max-height: 420px;
                overflow-y: auto;
                background: var(--cl-surface, #fff);
                border: 1px solid var(--cl-border, #e2e7f2);
                border-radius: var(--cl-radius-md, 12px);
                box-shadow: var(--cl-shadow-card, 0 10px 40px rgba(20,60,130,.12));
                z-index: 1050;
                display: none;
            }

                .patient-notification-panel.open {
                    display: block;
                }

            .patient-notification-panel-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: .85rem 1rem;
                border-bottom: 1px solid var(--cl-border, #e2e7f2);
                font-weight: 700;
                font-size: .95rem;
            }

            .patient-notification-item {
                display: flex;
                gap: .6rem;
                padding: .75rem 1rem;
                border-bottom: 1px solid var(--cl-border, #e2e7f2);
                cursor: pointer;
                transition: background-color .12s ease;
            }

                .patient-notification-item:hover {
                    background: var(--cl-bg, #f5f7fb);
                }

                .patient-notification-item.unread {
                    background: var(--cl-primary-light, #eaf1ff);
                }

                .patient-notification-item .bi-capsule {
                    color: var(--cl-primary, #2f6fed);
                    font-size: 1.1rem;
                    flex: 0 0 auto;
                    margin-top: .1rem;
                }

            .patient-notification-item-title {
                font-weight: 600;
                font-size: .88rem;
                color: var(--cl-text, #14213d);
                margin-bottom: .15rem;
            }

            .patient-notification-item-message {
                font-size: .82rem;
                color: var(--cl-text-muted, #5b6b85);
                margin-bottom: .2rem;
            }

            .patient-notification-item-time {
                font-size: .72rem;
                color: var(--cl-text-muted, #5b6b85);
            }

            .patient-notification-empty {
                padding: 1.75rem 1rem;
                text-align: center;
                color: var(--cl-text-muted, #5b6b85);
                font-size: .88rem;
            }

            .patient-notification-footer {
                padding: .6rem 1rem;
                text-align: center;
                border-top: 1px solid var(--cl-border, #e2e7f2);
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="patient-body">

    <div class="patient-wrapper">

        <!-- Sidebar -->
        <aside class="patient-sidebar" id="patientSidebar">
            <div class="patient-sidebar-brand">
                <span class="patient-brand-mark">
                    <i class="bi bi-heart-pulse-fill"></i>
                </span>
                <span>CuraLink</span>
            </div>

            <nav class="patient-nav">
                <a class="patient-nav-link @(isActive("Dashboard") ? "active" : "")"
                   asp-controller="Patient" asp-action="Dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="patient-nav-link @(isActive("Profile") ? "active" : "")"
                   asp-controller="Patient" asp-action="Profile">
                    <i class="bi bi-person-circle"></i> My Profile
                </a>
                <a class="patient-nav-link @(isActive("MedicalRecords") ? "active" : "")"
                   asp-controller="Patient" asp-action="MedicalRecords">
                    <i class="bi bi-file-earmark-medical"></i> Medical Records
                </a>
                <a class="patient-nav-link @(isActive("Upload") ? "active" : "")"
                   asp-controller="Patient" asp-action="Upload">
                    <i class="bi bi-cloud-upload"></i> Upload Documents
                </a>

                <a class="patient-nav-link @(isActive("Doctors") ? "active" : "")"
                   asp-controller="Patient" asp-action="Doctors">
                    <i class="bi bi-search-heart"></i> Find a Doctor
                </a>

                <!-- Not implemented yet — no backing controller/API. Left visible
                     per the target IA but inert, so nothing 404s. -->
                <a class="patient-nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i class="bi bi-calendar-check"></i> Appointments
                    <span class="patient-nav-soon">Soon</span>
                </a>
            </nav>

            <div class="patient-sidebar-footer">
                <a asp-controller="Auth" asp-action="Logout" class="patient-nav-link patient-logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Main -->
        <div class="patient-main">

            <header class="patient-topbar">
                <button type="button" class="patient-sidebar-toggle d-lg-none" id="sidebarToggle" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="patient-topbar-title">@ViewData["Title"]</h1>

                <!-- Notification bell: always present on every patient page -->
                <div class="position-relative">
                    <button type="button"
                            class="patient-notification-bell"
                            id="notificationBell"
                            aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="patient-notification-badge d-none" id="notificationBadge">0</span>
                    </button>

                    <div class="patient-notification-panel" id="notificationPanel">
                        <div class="patient-notification-panel-header">
                            <span>Notifications</span>
                            <button type="button" class="btn btn-link btn-sm p-0" id="markAllReadBtn">
                                Mark all as read
                            </button>
                        </div>

                        <div id="notificationList">
                            <div class="patient-notification-empty">Loading…</div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="patient-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

        </div>
    </div>

    <div class="patient-sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/patient/layout.js" asp-append-version="true"></script>
    <script src="~/js/patient/notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
