@{
    ViewData["Title"] = "Pending Doctors";
}

@{
    Layout = "_Layout";
}

<div class="container-fluid py-4">

    <!-- Page header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="mb-1">Pending Doctors</h3>
            <p class="text-muted mb-0">Review and verify doctor registration requests.</p>
        </div>
        <button id="btnRefresh" type="button" class="btn btn-outline-secondary">
            Refresh
        </button>
    </div>

    <!-- Error alert -->
    <div id="pageErrorAlert" class="alert alert-danger d-none" role="alert">
        <strong class="me-1">Error:</strong>
        <span id="pageErrorAlertText">Something went wrong.</span>
    </div>

    <!-- Loading state -->
    <div id="loadingState" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-2 mb-0">Loading pending doctors...</p>
    </div>

    <!-- Empty state -->
    <div id="emptyState" class="text-center py-5 d-none">
        <p class="text-muted mt-3 mb-0">No pending doctors found.</p>
    </div>

    <!-- Doctors table -->
    <div id="tableWrapper" class="card shadow-sm d-none">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Doctor Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Specialty</th>
                        <th scope="col">Syndicate ID</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="doctorsTableBody">
                    <!-- rows injected by JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===================== Review Doctor Modal ===================== -->
<div class="modal fade" id="reviewDoctorModal" tabindex="-1" aria-labelledby="reviewDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reviewDoctorModalLabel">Doctor Verification Review</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div id="reviewModalError" class="alert alert-danger d-none" role="alert"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="text-muted small">Full Name</div>
                        <div class="fw-semibold" id="rd-fullName">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Status</div>
                        <div id="rd-status">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold" id="rd-email">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Phone</div>
                        <div class="fw-semibold" id="rd-phone">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Specialty</div>
                        <div class="fw-semibold" id="rd-specialty">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Syndicate ID</div>
                        <div class="fw-semibold" id="rd-syndicateId">-</div>
                    </div>
                </div>

                <hr />

                <h6 class="mb-3">Verification Document</h6>
                <div id="rd-documentLoading" class="text-muted small">
                    <span class="spinner-border spinner-border-sm me-1"></span> Loading document info...
                </div>
                <div id="rd-documentEmpty" class="text-muted small d-none">
                    No verification document uploaded.
                </div>
                <div id="rd-documentInfo" class="d-none">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center gap-2">
                                <div>
                                    <div class="fw-semibold" id="rd-fileName">-</div>
                                    <div class="text-muted small">
                                        <span id="rd-contentType">-</span> ·
                                        <span id="rd-fileSize">-</span> ·
                                        Uploaded <span id="rd-uploadedAt">-</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <a id="rd-viewDocumentBtn" href="#" target="_blank" rel="noopener noreferrer"
                               class="btn btn-outline-primary btn-sm">
                                View Document
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Rejection reason section (hidden until "Reject" is clicked) -->
                <div id="rejectionSection" class="mt-4 d-none">
                    <hr />
                    <label for="rejectionReasonInput" class="form-label fw-semibold">
                        Rejection Reason <span class="text-danger">*</span>
                    </label>
                    <textarea id="rejectionReasonInput" class="form-control" rows="3"
                              placeholder="Please provide a reason for rejecting this doctor's verification."></textarea>
                    <div class="invalid-feedback" id="rejectionReasonError">
                        Rejection reason is required.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- Default action buttons -->
                <div id="reviewActionButtons" class="d-flex w-100 justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnStartReject" class="btn btn-outline-danger">
                            Reject
                        </button>
                        <button type="button" id="btnApprove" class="btn btn-success">
                            Approve
                        </button>
                    </div>
                </div>

                <!-- Rejection confirm/cancel buttons (hidden until "Reject" is clicked) -->
                <div id="rejectionActionButtons" class="d-none w-100 justify-content-end gap-2">
                    <button type="button" id="btnCancelReject" class="btn btn-outline-secondary">Cancel</button>
                    <button type="button" id="btnConfirmReject" class="btn btn-danger" disabled>
                        Confirm Rejection
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== Approve Confirmation Modal ===================== -->
<div class="modal fade" id="approveConfirmModal" tabindex="-1" aria-labelledby="approveConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approveConfirmModalLabel">Confirm Approval</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to approve <strong id="approveDoctorName">this doctor</strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmApprove" class="btn btn-success">
                    <span id="approveSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    Yes, Approve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== Toast container ===================== -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="actionToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="actionToastBody">Done.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@* Antiforgery token, read by JS and sent on the VerifyDoctor POST (see note in the JS file). *@
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/admin/pending-doctors.js"></script>
}
