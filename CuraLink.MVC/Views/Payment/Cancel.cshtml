@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="container py-5">
    <div class="text-center">

        <h1 class="fw-bold">Payment Cancelled</h1>

        <p class="text-muted mt-3">
            Your payment was cancelled. Your appointment has not been paid.
        </p>

        <a asp-controller="Patient"
           asp-action="Dashboard"
           class="btn btn-primary mt-3">
            Back to Dashboard
        </a>

    </div>
</div>