@model CuraLink.MVC.Models.Doctors.AddAssistantViewModel
@{
    ViewData["Title"] = "Add Assistant";
    Layout = "_DoctorLayout";
}

<div class="doctor-card" style="max-width:560px;">
    <div class="doctor-card-header">
        <h2 class="doctor-page-title">Add Assistant</h2>
        <p class="doctor-page-subtitle">
            An invitation link will be emailed to the assistant for <strong>@Model.ClinicName</strong>.
            It expires after 2 days.
        </p>
    </div>

    <form asp-action="AddAssistant" method="post" class="doctor-form" novalidate>
        <input type="hidden" asp-for="ClinicId" />
        <input type="hidden" asp-for="ClinicName" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Assistant email</label>
            <div class="input-group doctor-input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" type="email" class="form-control" maxlength="256"
                       placeholder="assistant@example.com" autocomplete="off" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary doctor-submit-btn">
                <i class="bi bi-send me-1"></i> Send Invitation
            </button>
            <a asp-action="Assistants" asp-route-clinicId="@Model.ClinicId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>