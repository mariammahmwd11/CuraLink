@model List<CuraLink.MVC.Models.Patients.MyAppointmentViewModel>
@{
    ViewData["Title"] = "My Appointments";
    Layout = "_doctorLayout";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-x fs-1"></i>
        <h5 class="mt-3">No appointments yet</h5>
        <a asp-controller="Patient" asp-action="Doctors" class="btn btn-primary mt-2">Find a Doctor</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var a in Model)
        {
            var chatAllowed = a.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)
                           || a.Status.Equals("Paid", StringComparison.OrdinalIgnoreCase);

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0">@a.PatientName</h6>
                            <span class="badge bg-secondary">@a.Status</span>
                        </div>
                        @if (!string.IsNullOrEmpty(a.ClinicName))
                        {
                            <div class="text-muted small mb-2"><i class="bi bi-hospital me-1"></i>@a.ClinicName</div>
                        }
                        <div class="small"><i class="bi bi-calendar-event me-1"></i>@a.Date.ToString("ddd, dd MMM yyyy")</div>
                        <div class="small"><i class="bi bi-clock me-1"></i>@a.StartTime.ToString(@"hh\:mm") - @a.EndTime.ToString(@"hh\:mm")</div>
                    </div>
                    @if (chatAllowed)
                    {
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <a class="btn btn-outline-primary btn-sm w-100"
                               asp-controller="Chat" asp-action="Index" asp-route-appointmentId="@a.Id">
                                <i class="bi bi-chat-dots me-1"></i> Open Chat
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}