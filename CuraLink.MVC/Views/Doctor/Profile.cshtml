@model CuraLink.MVC.Models.Patients.PatientProfileViewModel
@using System.Linq
@{
    ViewData["Title"] = "My Profile";
    Layout = "_DoctorLayout";
    var initials = Model.HasName
        ? $"{Model.FirstName?.FirstOrDefault()}{Model.LastName?.FirstOrDefault()}".ToUpperInvariant()
        : Model.Email.Length > 0 ? Model.Email[0].ToString().ToUpperInvariant() : "D";
}

<div class="doctor-card" style="max-width: 640px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoUrl))
        {
            <img src="@Model.ProfilePhotoUrl" alt="Profile photo" class="rounded-circle border"
                 style="width:72px;height:72px;object-fit:cover;" />
        }
        else
        {
            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold text-primary"
                  style="width:72px;height:72px;background:#eaf1ff;font-size:1.5rem;">@initials</span>
        }
        <div>
            <h2 class="h5 mb-1">@(Model.HasName ? $"Dr. {Model.FirstName} {Model.LastName}".Trim() : Model.Email)</h2>
            <span class="text-success small"><i class="bi bi-check-circle-fill"></i> Active account</span>
        </div>
    </div>

    <dl class="mb-4">
        <dt class="text-muted small fw-normal">Email</dt>
        <dd class="fw-semibold">@Model.Email</dd>

        <dt class="text-muted small fw-normal">Phone number</dt>
        <dd class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</dd>

        <dt class="text-muted small fw-normal">Bio</dt>
        <dd class="fw-semibold mb-0" style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Bio) ? "Not set" : Model.Bio)</dd>
    </dl>

    <a asp-controller="Doctor" asp-action="EditProfile" class="btn btn-primary">
        <i class="bi bi-pencil me-1"></i> Edit Profile
    </a>
</div>
