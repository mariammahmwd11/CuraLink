@model CuraLink.MVC.Models.AssistantDashboardViewModel
@{
    ViewData["Title"] = "Assistant Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    Layout = "~/Views/Shared/_AssistantLayout.cshtml";
}

<h2 class="patient-welcome-title">Welcome, @User.Identity?.Name</h2>
<p class="patient-welcome-subtitle">
    @if (!string.IsNullOrWhiteSpace(Model.ClinicName))
    {
        <text>Receptionist at <strong>@Model.ClinicName</strong>. Here is today's clinic activity.</text>
    }
    else
    {
        <text>Here is today's clinic activity.</text>
    }
</p>

<!-- Today's numbers -->
<div class="patient-stats-row">
    <div class="patient-stat-card">
        <div class="patient-stat-top">
            <span class="patient-stat-icon"><i class="bi bi-calendar-event"></i></span>
            <div><div class="patient-stat-value">@Model.TotalToday</div><div class="patient-stat-label">Today's appointments</div></div>
        </div>
    </div>
    <div class="patient-stat-card">
        <div class="patient-stat-top">
            <span class="patient-stat-icon"><i class="bi bi-hourglass-split"></i></span>
            <div><div class="patient-stat-value">@Model.Waiting</div><div class="patient-stat-label">Waiting to check in</div></div>
        </div>
    </div>
    <div class="patient-stat-card">
        <div class="patient-stat-top">
            <span class="patient-stat-icon"><i class="bi bi-door-open"></i></span>
            <div><div class="patient-stat-value">@Model.CheckedIn</div><div class="patient-stat-label">In the clinic now</div></div>
        </div>
    </div>
    <div class="patient-stat-card">
        <div class="patient-stat-top">
            <span class="patient-stat-icon"><i class="bi bi-check2-circle"></i></span>
            <div><div class="patient-stat-value">@Model.Completed</div><div class="patient-stat-label">Completed today</div></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Today's schedule -->
    <div class="col-lg-8">
        <div class="patient-section-header">
            <h3 class="patient-section-title">Today's schedule</h3>
        </div>

        @if (Model.TodayAppointments.Count == 0)
        {
            <div class="patient-empty-state">
                <div class="patient-empty-icon"><i class="bi bi-calendar2-x"></i></div>
                <div class="patient-empty-title">No appointments today</div>
                <div class="patient-empty-subtitle mb-0">Appointments for your clinic will appear here.</div>
            </div>
        }
        else
        {
            <div class="table-responsive patient-document-row d-block p-0">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            var badge = a.Status switch
                            {
                                "CheckedIn" => "bg-primary",
                                "Completed" => "bg-success",
                                "Cancelled" => "bg-secondary",
                                _ => "bg-warning text-dark"
                            };
                            <tr>
                                <td class="fw-semibold">@a.Time</td>
                                <td>@a.PatientName</td>
                                <td>@a.DoctorName</td>
                                <td><span class="badge @badge">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Quick actions -->
    <div class="col-lg-4">
        <div class="patient-section-header">
            <h3 class="patient-section-title">Quick actions</h3>
        </div>
        <div class="d-grid gap-2">
            <button class="btn btn-primary" disabled><i class="bi bi-plus-circle me-2"></i>Book appointment for a patient</button>
            <button class="btn btn-outline-primary" disabled><i class="bi bi-person-check me-2"></i>Check in a patient</button>
            <button class="btn btn-outline-primary" disabled><i class="bi bi-search me-2"></i>Find a patient</button>
        </div>
        <p class="text-muted small mt-2 mb-0">These actions will be enabled once the clinic endpoints are ready.</p>
    </div>
</div>
