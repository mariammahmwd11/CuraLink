@model List<CuraLink.MVC.Models.Patients.MedicalDocumentViewModel>

@{
    ViewData["Title"] = "Medical Records";
    Layout = "_PatientLayout";
}

<div class="patient-section-header">
    <h3 class="patient-section-title">Medical Records</h3>

    <a asp-controller="Patient"
       asp-action="Upload"
       class="btn btn-primary">
        <i class="bi bi-cloud-upload me-1"></i>
        Upload Document
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (Model != null && Model.Any())
{
    foreach (var doc in Model)
    {
        <div class="patient-document-row">

            <span class="patient-document-icon">
                <i class="bi @doc.FileIconClass"></i>
            </span>

            <div class="patient-document-info">
                <p class="patient-document-name">
                    @doc.FileName
                </p>

                <span class="patient-document-meta">
                    @doc.FileSizeDisplay
                    &middot;
                    Uploaded @doc.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")
                </span>
            </div>

            <div class="patient-document-actions">

                <!-- View -->
                <a asp-controller="Patient"
                   asp-action="ViewMedicalDocument"
                   asp-route-id="@doc.Id"
                   target="_blank"
                   class="btn btn-sm btn-outline-secondary"
                   title="View document">
                    <i class="bi bi-eye"></i>
                </a>

                <!-- Download -->
                <a asp-controller="Patient"
                   asp-action="DownloadMedicalDocument"
                   asp-route-id="@doc.Id"
                   class="btn btn-sm btn-outline-secondary"
                   title="Download document">
                    <i class="bi bi-download"></i>
                </a>

                <!-- Delete -->
                <form asp-controller="Patient"
                      asp-action="DeleteMedicalDocument"
                      asp-route-id="@doc.Id"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this medical document?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger"
                            title="Delete document">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>

            </div>
        </div>
    }
}
else
{
    <div class="patient-empty-state">
        <div class="patient-empty-icon">
            <i class="bi bi-file-earmark-medical"></i>
        </div>

        <h4 class="patient-empty-title">
            You haven't uploaded any medical documents yet.
        </h4>

        <p class="patient-empty-subtitle">
            Your medical documents will appear here once uploaded.
        </p>

        <a asp-controller="Patient"
           asp-action="Upload"
           class="btn btn-primary">
            <i class="bi bi-cloud-upload me-1"></i>
            Upload Your First Document
        </a>
    </div>
}