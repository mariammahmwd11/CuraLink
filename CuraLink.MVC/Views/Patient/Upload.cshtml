@model CuraLink.MVC.Models.Patients.UploadMedicalDocumentViewModel
@{
    ViewData["Title"] = "Upload Documents";
    Layout = "_PatientLayout";
}

<div class="patient-upload-card">

    <div class="patient-card-header mb-3">
        <h1 class="h5 fw-bold mb-1">Upload Medical Documents</h1>
        <p class="text-muted mb-0">X-rays, lab results, scans, reports, and other medical documents.</p>
    </div>

    <div id="uploadAlertPlaceholder"></div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <form asp-controller="Patient" asp-action="Upload" method="post" enctype="multipart/form-data"
          novalidate id="uploadDocumentForm">

        @Html.AntiForgeryToken()

        <div class="patient-dropzone" id="uploadDropzone" tabindex="0" role="button"
             aria-label="Upload a medical document">

            <div id="uploadPrompt">
                <div class="patient-dropzone-icon"><i class="bi bi-cloud-upload"></i></div>
                <div class="patient-dropzone-title">Drag &amp; drop your files here</div>
                <div class="patient-dropzone-subtitle">or click to browse</div>
                <div class="patient-dropzone-formats">PDF, JPG, JPEG, PNG &middot; Maximum 10 MB per file</div>
            </div>

            <div id="uploadPreview" class="patient-upload-preview d-none">
                <span class="patient-upload-preview-icon"><i class="bi bi-file-earmark-fill" id="previewFileIcon"></i></span>
                <div class="flex-grow-1 text-start min-width-0">
                    <div class="fw-semibold text-truncate" id="previewFileName"></div>
                    <div class="text-muted small" id="previewFileSize"></div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="removeFileBtn">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <input asp-for="File" type="file" id="fileInput" class="d-none"
               accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />

        <span class="text-danger small d-block mt-2" id="fileError" hidden></span>
        <span asp-validation-for="File" class="text-danger small d-block"></span>

        <div class="patient-upload-progress-wrap d-none" id="uploadProgressWrap">
            <div class="progress" style="height: 6px;">
                <div class="progress-bar" id="uploadProgressBar" role="progressbar"
                     style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <div class="d-flex mt-4">
            <button type="submit" class="btn btn-primary" id="submitBtn">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="submitSpinner" role="status" aria-hidden="true"></span>
                <span id="submitBtnLabel">Upload</span>
            </button>
        </div>

    </form>

    <div class="patient-security-note">
        <i class="bi bi-shield-lock-fill"></i>
        <span>Your medical documents are securely stored and can be reviewed by your authorized healthcare providers.</span>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/patient/upload.js" asp-append-version="true"></script>
}
