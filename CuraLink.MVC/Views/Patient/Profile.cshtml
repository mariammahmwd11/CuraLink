@model CuraLink.MVC.Models.Patients.PatientProfileViewModel
@using System.Linq
@{
    ViewData["Title"] = "My Profile";
    Layout = "_PatientLayout";
    var initials = Model.HasName
        ? $"{Model.FirstName?.FirstOrDefault()}{Model.LastName?.FirstOrDefault()}".ToUpperInvariant()
        : Model.Email.Length > 0 ? Model.Email[0].ToString().ToUpperInvariant() : "P";
}

<div class="patient-profile-card">

    <div class="patient-profile-header">
        @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoUrl))
        {
            <img src="@Model.ProfilePhotoUrl" alt="Profile photo" class="patient-avatar patient-avatar-img" />
        }
        else
        {
            <span class="patient-avatar">@initials</span>
        }
        <div>
            <h2 class="patient-profile-name">
                @(Model.HasName ? $"{Model.FirstName} {Model.LastName}".Trim() : Model.Email)
            </h2>
            <span class="patient-profile-status">
                <i class="bi bi-check-circle-fill"></i> Active account
            </span>
        </div>
    </div>

    <div class="patient-profile-field">
        <span class="patient-profile-label">Email</span>
        <span class="patient-profile-value">@Model.Email</span>
    </div>

    <div class="patient-profile-field">
        <span class="patient-profile-label">Phone Number</span>
        <span class="patient-profile-value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</span>
    </div>

    <div class="patient-profile-field">
        <span class="patient-profile-label">Bio</span>
        <span class="patient-profile-value">@(string.IsNullOrWhiteSpace(Model.Bio) ? "Not set" : Model.Bio)</span>
    </div>

    <div class="mt-4">
        <a asp-controller="Patient" asp-action="Edit" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
    </div>

</div>

@* patient-avatar already renders initials via patient-dashboard.css;
   this adds the circular-photo variant without touching that file. *@
<style>
    css
    .patient-avatar-img {
        width: 64px;
        height: 64px;
        object-fit: cover;
        border-radius: 50%;
        flex-shrink: 0;
    }

    
</style>