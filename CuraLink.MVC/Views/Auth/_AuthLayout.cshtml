<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CuraLink</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 (swap for your LibMan/npm-managed local copy if preferred — see notes) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="auth-body">

    <div class="auth-wrapper">

        <!-- Brand / marketing panel — hidden on small screens -->
        <aside class="auth-brand-panel" aria-hidden="true">
            <div class="auth-brand-inner">
                <div class="auth-brand-logo">
                    <span class="auth-brand-mark">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </span>
                    <span class="auth-brand-name">CuraLink</span>
                </div>

                <h2 class="auth-brand-headline">Your care, connected.</h2>
                <p class="auth-brand-subtext">
                    One secure place to manage appointments, talk to your doctors,
                    and keep track of your health — anytime, anywhere.
                </p>

                <ul class="auth-feature-list">
                    <li>
                        <i class="bi bi-calendar2-check"></i>
                        <span>Book and manage appointments in seconds</span>
                    </li>
                    <li>
                        <i class="bi bi-file-earmark-medical"></i>
                        <span>Access your medical records anytime</span>
                    </li>
                    <li>
                        <i class="bi bi-shield-lock"></i>
                        <span>Bank-grade security for your health data</span>
                    </li>
                </ul>
            </div>

            <div class="auth-brand-footer">
                &copy; @DateTime.Now.Year CuraLink. All rights reserved.
            </div>
        </aside>

        <!-- Form panel -->
        <main class="auth-content-panel">
            <div class="auth-content-inner">

                <!-- Compact logo shown only on mobile / tablet where the brand panel is hidden -->
                <div class="auth-mobile-logo d-lg-none">
                    <span class="auth-brand-mark">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </span>
                    <span class="auth-brand-name">CuraLink</span>
                </div>

                @RenderBody()

            </div>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/validation-adapters.js" asp-append-version="true"></script>

    <script src="~/js/auth.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
